{
  "name": "wisdom-workshop",
  "version": "2.0.0",
  "description": "智卷工坊 · 小初高学科教辅专家",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:cap": "vite build && npx cap sync && node scripts/verify-cap-build.cjs",
    "build:vercel": "cross-env BASE_URL=/ vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "start": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "lint": "eslint src --ext .js,.vue --fix",
    "format": "prettier --write \"src/**/*.{js,vue,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@supabase/supabase-js": "^2.110.9",
    "@tiptap/extension-color": "^3.23.4",
    "@tiptap/extension-font-family": "^3.23.4",
    "@tiptap/extension-highlight": "^3.23.4",
    "@tiptap/extension-image": "^3.23.4",
    "@tiptap/extension-placeholder": "^3.23.4",
    "@tiptap/extension-subscript": "^3.23.4",
    "@tiptap/extension-superscript": "^3.23.4",
    "@tiptap/extension-table": "^3.23.4",
    "@tiptap/extension-table-cell": "^3.23.4",
    "@tiptap/extension-table-header": "^3.23.4",
    "@tiptap/extension-table-row": "^3.23.4",
    "@tiptap/extension-text-align": "^3.23.4",
    "@tiptap/extension-text-style": "^3.23.4",
    "@tiptap/extension-underline": "^3.23.4",
    "@tiptap/starter-kit": "^3.23.4",
    "@tiptap/vue-3": "^3.23.4",
    "axios": "^1.6.7",
    "docx": "^8.5.0",
    "exceljs": "^4.4.0",
    "html-to-docx": "^1.8.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.6.0",
    "node-machine-id": "^1.1.12",
    "pdfjs-dist": "^4.0.379",
    "pinia": "^2.3.1",
    "puppeteer": "^24.42.0",
    "vite-plugin-pwa": "^1.3.0",
    "vue": "^3.4.21",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@pinia/testing": "^0.1.7",
    "@types/node": "^26.1.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/test-utils": "^2.4.11",
    "concurrently": "^8.2.2",
    "electron": "^29.1.1",
    "electron-builder": "^24.13.3",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^9.33.0",
    "jsdom": "^24.1.3",
    "prettier": "^3.8.3",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3",
    "vite": "^5.1.5",
    "vitest": "^1.6.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.wisdom.workshop",
    "productName": "智卷工坊",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "python-scripts/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "python-scripts/",
        "to": "python-scripts/"
      }
    ],
    "win": {
      "icon": "public/icon.svg",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "智卷工坊"
    }
  }
}
