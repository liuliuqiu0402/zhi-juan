#!/bin/sh
# 🔧 pre-commit 大文件守卫钩子
# 作用：第二道防线，防止大二进制/模型/压缩包等被强制提交进仓库
#      （.gitignore 是第一道，本钩子拦截 `git add -f` 之类的强制添加）
# 用法：git config core.hooksPath githooks   （在仓库根目录执行一次）
#
# 规则分两层：
#   1) 黑名单扩展名 → 任何文件都拒绝（模型权重/压缩包/安装包/音视频/镜像）
#   2) 大小阈值     → 超过阈值的任意文件拒绝（含图片等非黑名单扩展名）
#
# 如需临时放行（不推荐），可用：git commit --no-verify

# ── 环境兜底：确保能找到 git（部分 shell 环境 PATH 不完整）──
case ":$PATH:" in
  *":/mingw64/bin:"*) ;;
  *) export PATH="/mingw64/bin:/usr/bin:/bin:$PATH" ;;
esac
command -v git >/dev/null 2>&1 || { echo "✗ pre-commit: 找不到 git 命令" >&2; exit 1; }

# ── 可调参数 ────────────────────────────────────────────
# 单文件大小上限（字节）。默认 50MB，为 GitHub 100MB 硬限制留余量。
MAX_SIZE=$((50 * 1024 * 1024))

# 图片单独更低阈值（大图资源/素材不宜入仓，阈值 10MB）
MAX_IMG_SIZE=$((10 * 1024 * 1024))

# ── 白名单：仓库自带的极小音频素材（有意入库、体积可忽略）────────────
# 背景：听力音频的"叮咚"提示音 assets/listening-chime.mp3 只有 8KB，且与 Edge 合成流
#      同为 MPEG-2 Layer III，必须按字节拼接，无法改成运行时生成的文本。
#      它由 scripts/gen-listening-chime.cjs 可复现（同脚本产出逐字节一致），
#      属"有意入库的音效素材"，与黑名单要拦的模型权重/安装包/大媒体不是一回事。
# 约束（只放行这一种情况，其余一律照旧拒绝）：
#   · 仅限 assets/ 目录下的单层音频文件（mp3|wav|ogg|m4a）
#   · 且体积 ≤ 256KB —— 超过即视为"素材/大文件"，仍被拦下
ALLOW_ASSET_AUDIO_RE='^assets/[^/]+\.(mp3|wav|ogg|m4a)$'
ALLOW_ASSET_AUDIO_MAX=$((256 * 1024))

# 黑名单：模型权重 + 压缩包 + 安装包 + 音视频 + 镜像
BAD_EXT='safetensors|onnx|pt|pth|ckpt|gguf|h5|pb|tflite|keras|weight|bin|'
BAD_EXT="${BAD_EXT}zip|rar|7z|gz|bz2|xz|tar|"
BAD_EXT="${BAD_EXT}exe|msi|dmg|apk|aab|deb|rpm|"
BAD_EXT="${BAD_EXT}mp4|mkv|avi|mov|wmv|flv|mp3|wav|flac|aac|"
BAD_EXT="${BAD_EXT}iso|img"

# ── 主体 ────────────────────────────────────────────────
violations=""
error=0

# 进程替换 <(...) 让 while 在当前 shell 执行，error 修改可传回；
# 且保留 NUL 分隔（-z），正确处理含空格/中文文件名
while IFS= read -r -d '' file; do
  [ -z "$file" ] && continue

  ext=$(printf '%s' "$file" | sed 's/.*\.\([^.]*\)$/\1/' | tr 'A-Z' 'a-z')
  size=$(git cat-file -s ":$file" 2>/dev/null)
  if [ -z "$size" ] || [ "$size" -le 0 ]; then
    continue
  fi

  # 层0：白名单 —— 仓库自带的极小音频素材放行（仅 assets/ 单层 + 音频扩展名 + ≤256KB）
  if printf '%s' "$file" | grep -Eq "$ALLOW_ASSET_AUDIO_RE" && [ "$size" -le "$ALLOW_ASSET_AUDIO_MAX" ]; then
    continue
  fi

  # 层1：黑名单扩展名 → 一律拒绝
  if printf '%s' "$ext" | grep -Eq "^($BAD_EXT)$"; then
    violations="${violations}  ✗ [${ext}]  ${file}  (${size} B)\n"
    error=1
    continue
  fi

  # 层2：大小阈值（图片更严）
  limit=$MAX_SIZE
  if printf '%s' "$ext" | grep -Eq '^(png|jpg|jpeg|gif|webp|bmp)$'; then
    limit=$MAX_IMG_SIZE
  fi
  if [ "$size" -gt "$limit" ]; then
    violations="${violations}  ✗ [${size} B > $((limit/1024/1024))MB]  ${file}\n"
    error=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACMRTUXB -z)

if [ "$error" -ne 0 ]; then
  echo "✗ 提交被阻止：检测到疑似大文件/二进制入库"
  printf '%b' "$violations"
  echo ""
  echo "处理建议："
  echo "  · 模型权重/素材/安装包等 → 放本地目录，用 .gitignore 排除"
  echo "  · 确需入库 → 移到大文件存储（Git LFS/网盘），或从暂存区移除"
  echo "  · 仅本次强制跳过 → git commit --no-verify (不推荐)"
  exit 1
fi

exit 0
echo "SENTINEL-RAN" > /tmp/hook-sentinel.txt